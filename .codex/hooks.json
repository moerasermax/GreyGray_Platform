{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" ./.codex/hooks/session-brief.sh",
            "timeout": 20,
            "statusMessage": "讀取生效中的派工"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" ./.codex/hooks/dispatch-guard.sh",
            "timeout": 20,
            "statusMessage": "檢查派工範圍"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" ./.codex/hooks/stop-gate.sh",
            "timeout": 30,
            "statusMessage": "檢查越界與 PM 同步"
          }
        ]
      }
    ]
  }
}
