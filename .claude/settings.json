{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-D:/WorkSpace/01_開發中_wip/GreyGray_Platform}/.claude/hooks/dispatch-guard.sh\"",
            "timeout": 10,
            "statusMessage": "檢查派工範圍"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-D:/WorkSpace/01_開發中_wip/GreyGray_Platform}/.claude/hooks/stop-gate.sh\"",
            "timeout": 20,
            "statusMessage": "檢查越界與 PM 同步"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-D:/WorkSpace/01_開發中_wip/GreyGray_Platform}/.claude/hooks/claim-package.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
